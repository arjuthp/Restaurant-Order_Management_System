								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Waiter\",\n  \"description\": \"Duplicate role test\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/roles",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "roles"]
						},
						"description": "Should return 400 - Role already exists"
					},
					"response": []
