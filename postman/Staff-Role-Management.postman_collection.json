									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@restaurant.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+1234567890\",\n  \"roleId\": \"{{roleId}}\",\n  \"employeeId\": \"EMP1001\",\n  \"hireDate\": \"2024-01-15\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/staff",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "staff"]
						},
						"description": "Create a new staff member (Admin only). Use a valid roleId from seeded roles."
					},
					"response": []
