{
	"info": {
		"_postman_id": "staff-role-management-001",
		"name": "Staff & Role Management API",
		"description": "Complete API testing collection for Staff and Role Management System",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "roleId",
			"value": "",
			"type": "string"
		},
		{
			"key": "staffId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Setup - Admin Login",
			"item": [
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Save admin token for subsequent requests",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('adminToken', response.data.accessToken);",
									"    console.log('✅ Admin token saved:', response.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@restaurant.com\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/admin/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "admin", "login"]
						},
						"description": "Login as admin to get access token. Token is automatically saved for other requests."
					},
					"response": []
				}
			],
			"description": "First, login as admin to get the access token"
		},
		{
			"name": "1. Role Management",
			"item": [
				{
					"name": "Create Role",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Save roleId for subsequent requests",
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('roleId', response.data._id);",
									"    console.log('✅ Role created with ID:', response.data._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Kitchen Helper\",\n  \"description\": \"Assists chefs in the kitchen\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/roles",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "roles"]
						},
						"description": "Create a new role (Admin only)"
					},
					"response": []
				},
				{
					"name": "Get All Roles",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/roles",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "roles"]
						},
						"description": "Get all roles (Admin only)"
					},
					"response": []
				},
				{
					"name": "Get All Active Roles",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/roles?isActive=true",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "roles"],
							"query": [
								{
									"key": "isActive",
									"value": "true"
								}
							]
						},
						"description": "Get only active roles (Admin only)"
					},
					"response": []
				},
				{
					"name": "Get Role by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/roles/{{roleId}}",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "roles", "{{roleId}}"]
						},
						"description": "Get a specific role by ID (Admin only)"
					},
					"response": []
				},
				{
					"name": "Update Role",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Kitchen Helper\",\n  \"description\": \"Assists chefs and maintains kitchen cleanliness\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/roles/{{roleId}}",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "roles", "{{roleId}}"]
						},
						"description": "Update role details (Admin only)"
					},
					"response": []
				},
				{
					"name": "Deactivate Role",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"isActive\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/roles/{{roleId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "roles", "{{roleId}}", "status"]
						},
						"description": "Deactivate a role (Admin only). Will fail if role has active staff."
					},
					"response": []
				},
				{
					"name": "Activate Role",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"isActive\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/roles/{{roleId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "roles", "{{roleId}}", "status"]
						},
						"description": "Activate a role (Admin only)"
					},
					"response": []
				}
			],
			"description": "Role CRUD operations"
		},
		{
			"name": "2. Staff Management",
			"item": [
				{
					"name": "Create Staff",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Save staffId for subsequent requests",
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('staffId', response.data._id);",
